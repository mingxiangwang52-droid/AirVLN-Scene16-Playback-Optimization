# Copy to .env and adjust paths for your machine. Do not commit .env.
AIRVLN_DATASET_DATA_DIR=../DATA/data
AIRVLN_PHASE_A_CKPT=
AIRVLN_AGENT_CHECKPOINT=
AIRVLN_SCENE16_DEMO_STABLE_POOL=live_server/runtime/scene16_single_scene_stable_pool.json
AIRVLN_SCENE16_PREVIEW_MANIFEST=live_server/runtime/scene16_preview_manifest.json
AIRVLN_SEGMENT_GROUNDING_RIDGE=
AIRVLN_BLACKWELL_RUNTIME_MARKER=

# AirSim / preview transport
AIRSIM_HOST=127.0.0.1
AIRSIM_PORT=30015
AIRVLN_PREVIEW_CAMERA_WIDTH=1280
AIRVLN_PREVIEW_CAMERA_HEIGHT=720
AIRVLN_PREVIEW_CAMERA_MAX_RAW_BYTES=3000000
AIRVLN_LIVE_PREVIEW_CAMERA=preview_0
AIRVLN_LIVE_JPEG_QUALITY=90

# Live server
AIRVLN_AGENT_GPU_ID=0
AIRVLN_AGENT_TRAINER_GPU_DEVICE=0
